th:100%;height:100%;opacity:.6;z-index:0}.swiper-cube .swiper-cube-shadow:before{content:\'\';background:#000;position:absolute;left:0;top:0;bottom:0;right:0;filter:blur(50px)}.swiper-cube .swiper-slide-next+.swiper-slide{pointer-events:auto;visibility:visible}.swiper-cube .swiper-slide-shadow-cube.swiper-slide-shadow-bottom,.swiper-cube .swiper-slide-shadow-cube.swiper-slide-shadow-left,.swiper-cube .swiper-slide-shadow-cube.swiper-slide-shadow-right,.swiper-cube .swiper-slide-shadow-cube.swiper-slide-shadow-top{z-index:0;-webkit-backface-visibility:hidden;backface-visibility:hidden}.swiper-flip{overflow:visible}.swiper-flip .swiper-slide{pointer-events:none;-webkit-backface-visibility:hidden;backface-visibility:hidden;z-index:1}.swiper-flip .swiper-slide .swiper-slide{pointer-events:none}.swiper-flip .swiper-slide-active,.swiper-flip .swiper-slide-active .swiper-slide-active{pointer-events:auto}.swiper-flip .swiper-slide-shadow-flip.swiper-slide-shadow-bottom,.swiper-flip .swiper-slide-shadow-flip.swiper-slide-shadow-left,.swiper-flip .swiper-slide-shadow-flip.swiper-slide-shadow-right,.swiper-flip .swiper-slide-shadow-flip.swiper-slide-shadow-top{z-index:0;-webkit-backface-visibility:hidden;backface-visibility:hidden}.swiper-creative .swiper-slide{-webkit-backface-visibility:hidden;backface-visibility:hidden;overflow:hidden;transition-property:transform,opacity,height}.swiper-cards{overflow:visible}.swiper-cards .swiper-slide{transform-origin:center bottom;-webkit-backface-visibility:hidden;backface-visibility:hidden;overflow:hidden}\n\n    .swiper-slide_nudge {\n        // width:auto !important;   //comment out this to remove the white lines\n        backface-visibility: hidden !important;\n    }\n    .swiper_nudge, .swiper-inner_nudge {\n        height: 90vh;\n        width:45vh;\n    }\n    .stories-container {\n        display: flex;\n        margin: 0;\n        justify-content : center;\n        padding : 1.25rem;\n      }\n      \n      .stories-container .content {\n        position: relative;\n        cursor: pointer;\n      }\n    \n      @media screen and (max-width: 991px){\n          .stories-container .content {\n            height: 345px!important;\n        }\n      }\n      @media screen and (max-width: 1200px){\n        .stories-container .content {\n            width: 310px!important;\n        }\n      }\n    \n      @media screen and (max-width: 1024px){\n        .stories-container .content {\n            height: auto!important;\n        }\n      }\n    \n      .stories-container .content {\n        height: 28rem!important;\n        position: relative;\n        z-index: 1;\n        cursor: pointer;\n        flex-shrink: 0;\n        height: 430px;\n        margin-right: 24px;\n        opacity: 1;\n        transform: scale(1) translateX(0)!important;\n        transition: opacity .33s,transform .33s,visibility .33s;\n        visibility: visible;\n        width: 20rem;\n    }\n    \n    \n    /* .stories-container .content:hover:before,\n    .stories-container .content:hover:after {\n        transform: translateX(5px);\n        transition: transform .33s;\n      } */\n    \n      .stories-container .content:hover:before {\n        transform: translateX(6px);\n    }\n    \n    \n      \n      .stories-container .content::before {\n        /* content: "";\n        height: 198px;\n        width: 98px;\n        background: linear-gradient(180deg,rgba(0,48,131,0),#003083);;\n        \n        position: absolute;\n        top: 50%;\n        left: 50%;\n        transform: translate(-50%, -50%);\n        z-index: 101; */\n        background: #ec9b31;\n        border-radius: 23px;\n        content: "";\n        height: 100%;\n        left: 0;\n        position: absolute;\n        top: 0;\n        transition: all .35s ease;\n        width: 100%;\n        z-index: -1;\n        \n      }\n      \n      .stories-container .content::after {\n        /* content: "";\n        height: 106px;\n        width: 106px;\n        background: linear-gradient(#dd2a7b, #f58529);\n       \n        position: absolute;\n        top: 50%;\n        left: 50%;\n        transform: translate(-50%, -50%);\n        z-index: 100; */\n        background: linear-gradient(180deg,rgba(0,48,131,0),#003083);\n        /* background: linear-gradient(180deg,transparent 49.88%,rgba(0,0,0,.9)); */\n        border-radius: 16px;\n        bottom: 0;\n        content: "";\n        height: 100%;\n        left: 0;\n        position: absolute;\n        right: 0;\n        top: 0;\n        width: 100%;\n      }\n    \n      .stories-container .background-cards {\n        align-items: center;\n        bottom: 0;\n        display: flex;\n        display: none;\n        position: absolute;\n        right: 0;\n        top: 0;\n        transform: translateZ(0);\n        transition: transform .2s;\n        z-index: -1;\n    }\n    \n    \n    .background-card-1, .background-card-2 {\n      border-bottom-right-radius: 16px;\n      border-top-right-radius: 16px;\n      width: 10px;\n    }\n    \n    .background-card-1 {\n      background: #000;\n      height: 398px;\n      margin: 0 2px;\n    }\n    \n    .background-card-2 {\n      background: #4d4d4d;\n      height: 366px;\n    }\n    \n    .stories-container .entry-point-card-img {\n      border-radius: 16px;\n      box-shadow: 0 2px 8px rgba(0,0,0,.2);\n      height: 100%;\n      /* -o-object-fit: cover; */\n      /* object-fit: cover; */\n      width: 100%;\n      vertical-align: middle;\n    }\n    \n    .ampTagNew img{\n      vertical-align: middle;\n    \n      margin-right: 5px;\n    \n    }\n    \n    .ampTagNew {\n      align-items: center;\n      background-color: #fff;\n      border-radius: 14px;\n      box-shadow: 0 4px 15px rgba(0,0,0,.25);\n      display: flex;\n      left: 20px;\n      padding: 4px 10px;\n      position: absolute;\n      top: 20px;\n      justify-content: center;\n      align-items: center;\n    }\n    \n    .ampTagNew p {\n      color: #000;\n      font-size: 12px;\n      font-weight: 700;\n      line-height: 150%;\n      margin: 0;\n      text-transform: uppercase;\n    }\n\n    .ampTagNew1 {\n      align-items: center;\n      background-color: #fff;\n      border-radius: 20px;\n      box-shadow: 0 4px 15px rgba(0,0,0,.25);\n      display: flex;\n      padding: 5px 10px;\n      justify-content: center;\n      align-items: center;\n      margin-bottom:0.5rem;\n      flex-wrap:wrap;\n      \n    }\n    \n    .ampTagNew1 p {\n      color: #125590;\n      font-size: 0.625rem;\n      font-weight: 700;\n      line-height: 0.938rem;\n      margin: 0;\n      text-transform: uppercase;\n      word-wrap: break-word;\n      // width: 15vw;\n      max-width: 11rem;\n      text-align: center;\n      align-items: center;\n    }\n    \n    .card-headline-container {\n      bottom: 2px;\n      padding: 24px;\n      position: absolute;\n      text-align: left;\n      z-index: 1;\n      width: 100%;\n    }\n    \n    .card-headline-container .topHead {\n      color: #fff;\n      display: block;\n      font-size: 12px;\n      font-weight: 300;\n      line-height: 18px;\n      margin-bottom: 15px;\n      text-transform: uppercase;\n    }\n    \n    .entry-point-card-headline {\n      font-size: 1.25rem;\n      font-weight: 700;\n      line-height: 140%;\n      text-transform: inherit;\n      color: #fff;\n    }\n\n\n    .nudgeCircularContent{\n      /* padding: 2rem; */\n      display: flex;\n      flex-direction: column;\n      gap:1rem;\n      width: 16vw;\n      max-width: 18rem;\n      align-items: center;\n    }\n    \n   .nudgeCircularImageStory{\n      height: 10rem;\n      width: 10rem;\n      min-height: 10rem;\n      min-width: 10rem;\n      border-radius: 50%;\n      object-fit: cover;\n      position: relative;\n      z-index: 4;\n      top:50%;\n      left:50%;\n      transform: translate(-50%,-50%);\n    }\n    \n    .nudgeCircularImageContent{\n      position: relative;\n      cursor: pointer;\n      padding:0.5rem;\n    }\n    \n    .nudgeCircularImageContent1{\n      content:"";\n      height: 11rem;\n      width: 11rem;\n      border-radius: 50%;\n      background-color: #FFFFFF;\n      position: absolute;\n      top:50%;\n      left:50%;\n      transform: translate(-50%,-50%);\n      z-index: 3;\n    }\n\n    .nudgeCircularImageContent3{\n      content:"";\n      height: 11.5rem;\n      width: 11.5rem;\n      border-radius: 50%;\n      // background: linear-gradient(#dd2a7b,#f58529);\n      position: absolute;\n      top:50%;\n      left:50%;\n      transform: translate(-50%,-50%);\n      z-index: 2;\n    }\n    \n    .nudgeCircularImageContent2{\n      content:"";\n      height: 11.5rem;\n      width: 11.5rem;\n      border-radius: 50%;\n      position: absolute;\n      top:50%;\n      left:50%;\n      transform: translate(-50%,-50%);\n      z-index: 2;\n      fill:none;\n      stroke:linear-gradient(\n        45deg,\n        #2F815C 25%,\n        #599A7d 50%,\n        #82B39D 75%,\n        #ACCDBE 100%,\n      );\n      stroke-linecap: round;\n      stroke-width:3;\n      stroke-dasharray: 1;\n      stroke-dashoffset: 0;\n      animation: stroke-draw 6s ease-out infinite alternate; \n    }\n\n    @keyframes stroke-draw {\n      from{\n        stroke-dasharray: 1;\n      }\n      to{\n        stroke-dasharray: 8;\n      }\n    }\n    \n    \n    \n    .nudgeCircularTextContainer{\n      display: flex;\n      flex-direction: column;\n      gap: 2px;\n      justify-content: center;\n      align-items: center;\n      width: 11.5rem;\n      \n      /* overflow: hidden; */\n    }\n    \n    .nudgeCircularSubTitle, .nudgeCircularTitle{\n      word-wrap: break-word;\n      width: 11.5rem;\n      text-align: center;\n      align-items: center;\n    }\n    \n    .nudgeCircularTitle{\n      font-size: 1.25rem;\n      line-height: 1.5rem;\n      font-weight: 600;\n    }\n    \n    .nudgeCircularSubTitle{\n      font-size: 1rem;\n      line-height: 1.25rem;\n      font-weight: 400;\n    }\n    \n    \n    @media (max-aspect-ratio: 35/40){\n      .stories-container{\n       justify-content : start;\n       padding:0;\n        gap:2rem;\n      }\n      .nudgeCircularTitle{\n        font-size: 0.75rem;\n        line-height: 0.875rem;\n        width: 5.125rem;\n      }\n      .nudgeCircularSubTitle{\n        font-size: 0.5rem;\n        line-height: 0.625rem;\n        width: 5.125rem;\n      }\n      .nudgeCircularContent{\n        gap:0.5rem;\n      }\n\n      .ampTagNew1{\n        padding: 5px 5px;\n      }\n\n      .ampTagNew1 p{\n        font-size: 0.5rem;\n        line-height: 0.625rem;\n        // width:24vw;\n        max-width: 5.125rem;\n        // white-space:nowrap;\n      }\n      .nudgeCircularImageStory{\n        height: 4.25rem;\n        width: 4.25rem;\n        min-height: 4.25rem;\n        min-width: 4.25rem;\n\n      }\n      .nudgeCircularImageContent1{\n        height:4.75rem;\n        width:4.75rem;\n      }\n      .nudgeCircularImageContent2{\n        height:4.25rem;\n        width:4.25rem;\n      }\n         .nudgeCircularImageContent3{\n        height:5.125rem;\n        width:5.125rem;\n      }\n      .nudgeCircularTextContainer{\n        width: 4.25rem;\n      }\n    }\n    \n    \n    \n    \n      \n      .story-full {\n        background: rgba(21, 20, 20, 1);\n        backdrop-filter: blur(10px);\n        // padding-top: 4rem;\n        padding-bottom: 4rem;\n        position: fixed;\n        left: 0;\n        top: 0;\n        height: 100vh;\n        width: 100%;\n        z-index: 500;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        opacity: 0;\n        pointer-events: none;\n        transition: all 100ms ease;\n      }\n      \n      \n      \n    .story-full.active {\n      opacity: 1;\n      pointer-events: auto;\n      \n    }\n    \n    \n    .story-full .buttonBox{\n      \n      z-index: 999999;\n      /* margin-top: 8px; */\n      display: flex;\n      justify-content: end;\n    }\n    \n    .story-full .close-btn {\n      \n      cursor: pointer;\n      // width: 2rem;\n      z-index: 999999;\n      margin:1rem;\n      // margin-top: 8px;\n      \n    }\n    \n    .story-full .share-btn {\n      \n      cursor: pointer;\n      // width: 2rem;\n      z-index: 999999;\n      margin:1rem;\n      // margin-right:0;\n      // display: flex;\n      // justify-content: center;\n      \n    }\n    \n    .story-full .actionDiv{\n      display: flex;\n      /* position: absolute; */\n      /* bottom:4%; */\n      width:100%;\n      /* height: 8%; */\n      justify-content: center;\n      align-items: center;\n      overflow: hidden;\n      border-radius: 0px;\n      \n    }\n    \n    .story-full .actionButton{\n      justify-content: center;\n      display: flex;\n      padding:0 0 0 0;\n      width:auto;\n      /* height:100%; */\n      z-index: 9999;\n      background-color: #FFFFFF;\n      color:white;\n      align-items: center;\n      cursor: pointer;\n      font-size: 16px;\n      font-weight: 600;\n    }\n    \n    \n    .story-full .headingDiv{\n      position: absolute;\n      top:12%;\n      /* width:auto; */\n      width: 90%;\n      height: auto;\n      overflow: hidden;\n      /* justify-content: center; */\n      display: flex;\n      flex-direction: column;\n      gap: 0.5rem;\n      padding:0 0 0 0;\n      z-index: 9999;\n      align-items: center;\n      white-space: normal; \n      word-wrap: break-word; \n      \n    \n      transform: translateY(-200%);\n      opacity: 0;\n      /* Apply the animation */\n      animation: fly-in-top 1s ease-out 0.5s forwards;\n    }\n    \n    \n    @keyframes fly-in-top {\n      from {\n        transform: translateY(-200%);\n        opacity: 0;\n      }\n      to {\n        transform: translateY(0);\n        opacity: 1;\n      }\n    }\n    \n    .story-full .topHeadingDiv{\n      width:100%;\n      display: flex;\n      /* text-align: center; */\n    }\n    \n    .story-full .bodyDiv {\n      position: absolute;\n      bottom: 11%;\n      /* width: auto; */\n      width: 90%;\n      height: auto;\n      overflow: hidden;\n      /* justify-content: center; */\n      display: flex;\n      flex-direction: column;\n      gap: 0.5rem;\n      padding: 0;\n      z-index: 9999;\n      align-items: center;\n      cursor: pointer;\n      /* font-size: 40px;\n      font-weight: 900; */\n      white-space: normal; \n      word-wrap: break-word; \n      /* Start below the screen and invisible */\n      transform: translateY(200%);\n      opacity: 0;\n      /* Apply the animation */\n      animation: fly-in-bottom 1s ease-out 0.8s forwards;\n    }\n    \n    .story-full .topHeading,\n    .story-full .topBody,\n    .story-full .bottomHeading,\n    .story-full .bottomBody{\n      display:flex;\n      width: 100%;\n      white-space: normal; \n      word-wrap: break-word;\n      /* word-break: break-all; */\n    }\n    \n    .story-full .bottomBody{\n      margin-bottom: 10px;\n    }\n    \n    @keyframes fly-in-bottom {\n      from {\n        /* Begin from below the screen */\n        transform: translateY(200%);\n        opacity: 0;\n      }\n      to {\n        /* End at the final position */\n        transform: translateY(0);\n        opacity: 1;\n      }\n    }\n    \n    .story-full .volumeDiv{\n      display: flex;\n      position: absolute;\n      bottom:2%;\n      width:10%;\n      left:88%;\n      height: 8%;\n      justify-content: center;\n      align-items: center;\n      overflow: hidden;\n      border-radius: 0px;\n      // z-index:999;\n    }\n    \n    .story-full .muteOption {\n      \n      cursor: pointer;\n      width: 2rem;\n      z-index: 999999;\n      margin-top: 8px;\n      display: flex;\n      justify-content: center;\n      /* display: none; */\n    }\n    \n    .story-full .unmuteOption {\n      \n      cursor: pointer;\n      width: 2rem;\n      z-index: 999999;\n      margin-top: 8px;\n      display: flex;\n      justify-content: center;\n      /* display: none; */\n    }\n    \n    \n    .story-full .progressParent{\n      display: flex;\n      position: absolute;\n      top:0.5%;\n      gap:10%;\n      flex-direction: column;\n      justify-content: flex-start;\n      width:100%;\n      padding-top: 2%;\n      padding-left: 2%;\n      padding-right: 2%;\n      z-index:99999;\n    }\n    \n    .story-full .content .progress_nudge{\n      /* margin-left: 0.5rem;\n      margin-right: 0.5rem;\n      margin-top: 1rem; */\n      gap: 1%;\n      justify-content: space-between;\n    \n      /* position: absolute; */\n      /* top: 1rem;\n      left: 0; */\n      width: 100%;\n    \n      display: flex;\n      \n      align-items: center;\n      \n      \n    }\n\n\n    .nudgeSlideShimmer {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      background-image: linear-gradient(to right, #303030 8%, #101010 18%, #303030 33%);\n      background-size: 1000px 100%;\n      animation: nudgeFadeIn 1s infinite linear;\n      z-index: 9999999999;\n    }\n\n    .nudgeFadeInClass {\n      animation: nudgeFadeIn 1s infinite linear;\n      z-index: 9999999999;\n    }\n  \n    @keyframes nudgeFadeIn {\n        0% {\n            opacity:0,\n        }\n        100% {\n            opacity:1,\n        }\n    }\n    \n    .story-full .content .progress_nudge .lines{\n      height: 2px;\n      width:100%;\n      background-color: rgba(41, 41, 42, 0.5);\n      /* margin: 0 5px; */\n      margin: 0 1%;\n      z-index: 999999;\n      border-radius: 4px;\n    }\n    \n    .story-full .content .progress_nudge .lines.active {\n      background-color: rgb(255, 255, 255);\n      /* background-color: blue; */\n      height: 2px;\n      flex-grow: 1;\n      border-radius: 4px;\n      display: flex;\n      background-image: linear-gradient(to left, \n        rgba(88, 89, 104, .5) 0%, \n        rgba(88, 89, 104, .5) 50%, \n        rgba(255, 255, 255, .5) 50.001%, \n        rgba(255, 255, 255, .5) 100%);\n      background-repeat: no-repeat;\n      background-size: 200% 100%;\n      animation: Loader 15s linear reverse;\n    }\n    \n    \n    \n    @keyframes Loader {\n      0% { background-position: 0 0; }\n      100% { background-position: 100% 0; }\n    }\n    \n      \n      \n      \n    .story-full .content .left-arrow,\n    .story-full .content .right-arrow {\n      /* width: auto; */\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      background-color: white;\n      // padding: 0.25rem 0.25rem;\n      border-radius: 50%;\n      padding-top:0.5rem;\n      padding-bottom:0.5rem;\n      z-index:9999999;\n    }\n    \n    .story-full .content .left-arrow{\n      margin-right: 2rem;\n      padding-right:0.6rem;\n      padding-left:0.4rem;\n    }\n    .story-full .content .right-arrow{\n      margin-left: 2rem;\n      padding-left:0.6rem;\n      padding-right:0.4rem;\n    }\n\n    .story-full .content .leftSkipArrow,\n    .story-full .content .rightSkipArrow {\n      /* width: auto; */\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      background-color: transparent;\n      padding: 0.25rem 0.25rem;\n      border-radius: 50%;\n    }\n\n    .story-full .content .leftSkipArrow{\n      margin-right: 2rem;\n    }\n    .story-full .content .rightSkipArrow{\n      margin-left: 2rem;\n    }\n    \n    .story-full .content {\n      height: 100%;\n      display: flex;\n      align-items: center;\n      /* padding-top: 4rem;\n      padding-bottom: 4rem; */\n    }\n    \n    .story-full img {\n      width: 100%;\n      height: 100%;\n      z-index: 999;\n      object-fit: cover;\n      top:0;\n      position:relative ;\n    }\n    \n    .story-full video {\n      height: 100%;\n      z-index: 100;\n      object-fit: cover;\n      top:0;\n      position:relative ;\n    }\n\n    .nudge_custom_html {\n      display: flex; \n      justify-content: center; \n      align-items: center; \n      background-color: rgb(214, 213, 213);\n      z-index: 99995;\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      overflow: hidden;\n      object-fit: cover;\n      padding: 10px;\n    \n    }\n    \n    .nudge_custom_html > * {\n      object-fit: cover;\n    }\n    \n    .story-full .imgDiv { \n      height: 90vh;\n      width:45vh;\n      align-items: center;\n      vertical-align: middle;\n      position: relative;\n      display: flex;\n      border-radius: 16px;\n      justify-content: center;\n      overflow: hidden;\n      /* margin-top: 2rem;\n      margin-bottom: 2rem; */\n      \n    }\n    \n    .story-full .content .title {\n      position: absolute;\n      bottom: 26px;\n      left: 50%;\n      transform: translateX(-50%);\n      background: #fff;\n      // font-family: "Roboto", sans-serif;\n      line-height: 2;\n      padding: 8px 32px;\n    }\n    \n    \n    @media (max-aspect-ratio: 35/40) {\n      .story-full .content .left-arrow,\n      .story-full .content .right-arrow,\n      .story-full .content .leftSkipArrow,\n      .story-full .content .rightSkipArrow,\n       {\n          display: none;\n      }\n    \n      .story-full{\n        height: 100%;\n        padding:0;\n      }\n\n      .swiper_nudge, .swiper-inner_nudge {\n        width: 100vw;\n          height: 100%;\n          border-radius: 0;\n    }\n    \n      .story-full .imgDiv {\n          width: 100vw;\n          height: 100%;\n          border-radius: 0;\n      }\n    \n      .story-full video{\n        top: 0;\n        object-fit: cover;\n        width: 100%;\n      }\n    \n      .story-full .close-btn{\n        // height: 12px;\n        // width:12px;\n        // margin-left:6px;\n        // margin-top: 12px;\n        margin:1rem;\n      }\n    \n      .story-full .share-btn{\n        margin:1rem;\n        margin-right:0;\n      }\n    \n      .story-full .progress_nudge